# Template only. Copy this file to .env; the app reads .env, not .env.example.
# Replace the connection placeholders with your PostgreSQL server details.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assurancejsql_migration
DB_SCHEMA=dbo
DB_TABLE=Sinistre
DB_CLIENT_TABLE=TClient
DB_USER_TABLE=RUtilisateur_Depot
# Optional but recommended so sessions remain valid after an app restart.
# Generate with: py -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Agency (offline) server only — leave unset on Render. Written by deploy/agency/setup.ps1.
# REMOTE_DATABASE_URL=postgresql+psycopg://user:password@host.render.com:5432/database
# FRONTEND_DIR=C:/path/to/assurancebackend/deploy/agency/frontend
# SYNC_INTERVAL_SECONDS=15
